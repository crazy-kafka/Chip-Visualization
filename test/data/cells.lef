MACRO MUX2
  CLASS CORE ;
  SIZE 0.7 BY 1.2 ;
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    LAYER M1 ;
      RECT 0.0 0.3 0.1 0.5 ;
  END A
  PIN B
    DIRECTION INPUT ;
    USE SIGNAL ;
    LAYER M1 ;
      RECT 0.0 0.7 0.1 0.9 ;
