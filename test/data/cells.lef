MACRO INV
  CLASS CORE ;
  SIZE 0.3 BY 0.6 ;
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    LAYER M1 ;
      RECT 0.0 0.15 0.1 0.45 ;
  END A
  PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    LAYER M1 ;
      RECT 0.2 0.15 0.3 0.45 ;
  END Y
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    LAYER M1 ;
      RECT 0.05 0.0 0.25 0.1 ;
  END VDD
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    LAYER M1 ;
      RECT 0.05 0.5 0.25 0.6 ;
  END VSS
END INV

