MACRO BUFX2
  CLASS CORE ;
  SIZE 0.5 BY 1.0 ;
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    LAYER M1 ;
      RECT 0.0 0.3 0.1 0.7 ;
  END A
  PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    LAYER M1 ;
      RECT 0.4 0.3 0.5 0.7 ;
  END Y
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    LAYER M1 ;
      RECT 0.1 0.0 0.4 0.2 ;
  END VDD
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    LAYER M1 ;
      RECT 0.1 0.8 0.4 1.0 ;
  END VSS
END BUFX2

MACRO DFF
  CLASS CORE ;
  SIZE 0.8 BY 1.2 ;
  PIN D
    DIRECTION INPUT ;
    USE SIGNAL ;
    LAYER M1 ;
      RECT 0.0 0.4 0.1 0.8 ;
  END D
  PIN CK
    DIRECTION INPUT ;
    USE SIGNAL ;
    LAYER M1 ;
      RECT 0.0 0.2 0.1 0.3 ;
  END CK
  PIN Q
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    LAYER M1 ;
      RECT 0.7 0.4 0.8 0.8 ;
  END Q
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    LAYER M1 ;
      RECT 0.1 0.0 0.7 0.2 ;
  END VDD
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    LAYER M1 ;
      RECT 0.1 1.0 0.7 1.2 ;
  END VSS
END DFF

